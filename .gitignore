# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# marcador de migration já aplicada (docker compose db-init) — estado local, não código
.docker/db-init/migrate.done

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local

# O template DEVE ser versionado — sem ele ninguém sabe o que configurar.
!.env.example

# Permissões locais do Claude Code — estado de máquina, não governança.
# `agents/` e `skills/` continuam versionados: são o contrato do projeto.
.claude/settings.json
.claude/settings.local.json
