# ─── Portal do Cidadão — variáveis de ambiente ───────────────────────────────
# Copie para .env.local e preencha. Tudo é server-side (o cliente nunca vê).

# Tenant de desenvolvimento (single-tenant local). Em produção o tenant vem do subdomínio.
DEV_TENANT_SUBDOMAIN=dev
DEV_TENANT_NOME="Município de Demonstração"

# Backend do tributário (NestJS) — base da API v1.
TRIBUTARIO_BASE_URL=http://localhost:3000/api/v1

# Integração serviço-a-serviço com o tributário. O X-Service-Token DEVE bater com
# o PORTAL_SERVICE_TOKEN do tributário (>=16 chars). Gerar: openssl rand -hex 24
PORTAL_SERVICE_TOKEN=
# Segredo do proxy (x-proxy-secret), quando o tributário estiver atrás de proxy.
PROXY_SHARED_SECRET=

# OBRIGATÓRIO: assina (HMAC) o cookie de sessão do portal — sem ele a sessão
# poderia ser forjada pelo cliente. Em dev cai no PROXY_SHARED_SECRET se ausente.
# Gerar: openssl rand -hex 32
PORTAL_SESSION_SECRET=

# Senha do administrador da Carta de Serviços (/admin). Vazio = admin desabilitado.
PORTAL_ADMIN_SENHA=

# Cookies só com Secure em produção (https). "true" | "false" | vazio (auto por proto).
COOKIE_SECURE=false

# DEV: ecoa o código OTP na resposta do login (NUNCA ligar em produção).
DEV_OTP_ECHO=true

# Banco do portal (contas + catálogo). Porta 5434 = a mapeada pelo docker-compose.yml local.
DATABASE_URL="postgresql://postgres:docker@localhost:5434/portal_cidadao?schema=public"
